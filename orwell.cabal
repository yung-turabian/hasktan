cabal-version:       >=1.10

name:                orwell 
version:             0.1.1.2
synopsis:            A toy functional language based on Haskell.
-- description:
-- bug-reports:
license:               GPL-3
license-file:          LICENSE
author:                Henry Wandover
maintainer:            henrywandover@gmail.com
-- copyright:             GPL-3
category:              Programming Languages
build-type:            Simple
extra-source-files:    README.md, CHANGELOG.md

library
  exposed-modules:     Orwell 
  other-modules:       Orwell.Grammar, Orwell.Lexer, Orwell.TypeChecker, Orwell.Interpreter, Orwell.Util
  hs-source-dirs:      core/lib-Orwell/
  include-dirs:        include
  c-sources:           c-src/orwell-curses.c
  build-depends:       base, filepath, array, mtl
  default-language:    Haskell2010

executable orwl
  main-is:             Main.hs
  build-depends:       base, filepath, array, orwell 
  hs-source-dirs:      app
  default-language:    Haskell2010
  build-tool-depends:  happy:happy >= 1.20 && < 1.21

executable orwli
  main-is:             Interactive.hs
  build-depends:       base, filepath, haskeline, array, orwell 
  hs-source-dirs:      app
  default-language:    Haskell2010

