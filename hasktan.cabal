cabal-version:       >=1.10
-- Initial package description 'hasktan.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:                hasktan
version:             0.1.0.0
synopsis:            A toy functional language based on Haskell.
-- description:
-- bug-reports:
license:             BSD3
license-file:        LICENSE
author:              Henry Wandover
maintainer:          henrywandover@gmail.com
-- copyright:
category:            Programming Languages
build-type:          Simple
extra-source-files:  README.md, CHANGELOG.md

executable hasktan
  main-is:             Main.hs
  -- other-extensions:
  other-modules:       Hasktan, Grammar, Lexer, TypeChecker
  build-depends:       base, filepath, readline, array
  hs-source-dirs:      core
  default-language:    Haskell2010

executable hasktani
  main-is:             Interactive.hs
  -- other-extensions:
  other-modules:       Hasktan, Grammar, Lexer, TypeChecker
  build-depends:       base, filepath, readline, array
  hs-source-dirs:      core
  default-language:    Haskell2010

test-suite tests
   type:               exitcode-stdio-1.0
   main-is:            BasicTest.hs
   hs-source-dirs:     tests
   build-depends:      GHUT, base, HUnit
   default-language:   Haskell2010
