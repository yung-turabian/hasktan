cabal-version:       >=1.10
-- Initial package description 'hasqtan.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:                hasqtan
version:             0.1.0.0
synopsis:            A toy functional language based on Haskell.
-- description:
-- bug-reports:
license:             BSD3
license-file:        LICENSE
author:              Henry Wandover
maintainer:          henrywandover@gmail.com
-- copyright:
category:            Programming Languages
build-type:          Simple
extra-source-files:  README.md, CHANGELOG.md


library
  exposed-modules:     Hasqtan
  other-modules:       Hasqtan.Grammar, Hasqtan.Lexer, Hasqtan.TypeChecker, Hasqtan.Interpreter, Hasqtan.Util
  hs-source-dirs:      core/lib-Hasqtan/
  build-depends:       base, filepath, array, mtl
  default-language:    Haskell2010

executable hasqtan
  main-is:             Main.hs
  build-depends:       base, filepath, array, hasqtan
  hs-source-dirs:      app
  default-language:    Haskell2010
  build-tool-depends: happy:happy >= 1.20 && < 1.21

executable hasqtani
  main-is:             Interactive.hs
  build-depends:       base, filepath, readline, array, hasqtan
  hs-source-dirs:      app
  default-language:    Haskell2010

